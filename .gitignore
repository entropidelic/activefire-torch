# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ipynb_checkpoints/

# Data: downloaded or generated, never committed. The split files are
# recreated by `python -m activefire_torch.splits`; each run records a
# fingerprint of the split file it used (split_file_sha256 in config.yaml).
data/

# Evaluation output files (JSON), kept only on the machine that made them
results/r0/

# Run artifacts: keep config.yaml and history.csv; drop weights and the large
# TensorBoard / W&B logs (tens of MB per run with example pictures)
runs/*/weights*
runs/*/checkpoint*
runs/*/events*
runs/*/wandb/

# OS
.DS_Store

# Local planning notes
plan.md
